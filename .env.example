# Public site URL, used for SEO metadata, canonical URLs and sitemap.
NEXT_PUBLIC_SITE_URL=https://hasanbasheer.dev

# --- "Ask Hasan" AI assistant (optional) ---
# If ANTHROPIC_API_KEY is set, the /api/ask route answers with a live LLM
# grounded in the portfolio content. If it is absent, the route falls back
# to a local rule-based knowledge base and the site still works fully.
ANTHROPIC_API_KEY=
ASK_HASAN_MODEL=claude-haiku-4-5-20251001
